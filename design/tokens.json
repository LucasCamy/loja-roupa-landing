{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Aura Atelier · Warm Mediterranean Boutique. Espelho de src/styles/tokens.css (coleções de variáveis do Figma: Color, Radius, Space, Motion, Type).",
  "color": {
    "linen": { "$type": "color", "$value": "#FAF6F0", "$description": "Fundo da página" },
    "ivory": { "$type": "color", "$value": "#FFFDF9", "$description": "Cards, diálogos" },
    "sand": { "$type": "color", "$value": "#EFE7DA" },
    "sand-line": { "$type": "color", "$value": "#E2D5C1", "$description": "Divisórias (decorativo)" },
    "espresso": { "$type": "color", "$value": "#2C221E", "$description": "Texto principal · 14.40:1 em linen" },
    "taupe": { "$type": "color", "$value": "#6B584C", "$description": "Texto secundário · 6.24:1 em linen" },
    "terracotta": { "$type": "color", "$value": "#C4684E", "$description": "Marca decorativa · não usar como texto pequeno" },
    "terracotta-deep": { "$type": "color", "$value": "#9E4730", "$description": "CTA primário · branco 6.18:1" },
    "sage": { "$type": "color", "$value": "#6E8268", "$description": "Decorativo" },
    "sage-deep": { "$type": "color", "$value": "#4F6249", "$description": "Texto de sucesso · 6.14:1 em linen" },
    "sage-soft": { "$type": "color", "$value": "#E6ECE3" },
    "butter": { "$type": "color", "$value": "#F2D479" },
    "whatsapp-green": { "$type": "color", "$value": "#2F6B48", "$description": "CTA WhatsApp · branco 6.33:1" },
    "error": { "$type": "color", "$value": "#A3362A" }
  },
  "radius": {
    "badge": { "$type": "dimension", "$value": "4px" },
    "control": { "$type": "dimension", "$value": "10px" },
    "panel": { "$type": "dimension", "$value": "18px" },
    "frame": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": "0 1px 2px rgb(44 34 30 / .06), 0 8px 24px -12px rgb(44 34 30 / .18)" },
    "lift": { "$type": "shadow", "$value": "0 24px 60px -24px rgb(44 34 30 / .35)" }
  },
  "motion": {
    "ease-out": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "duration": { "instant": "120ms", "fast": "180ms", "base": "280ms", "slow": "560ms", "slower": "900ms" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "Cormorant Garamond Variable" },
    "sans": { "$type": "fontFamily", "$value": "Plus Jakarta Sans Variable" },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono Variable" }
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" }
}
